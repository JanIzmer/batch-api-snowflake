# Airflow settings shared by every service in docker-compose.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__PARALLELISM=16
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=8
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db:5432/airflow
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=False
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
# Keep secrets out of the DAG files: they are read as Airflow Variables.
AIRFLOW__CORE__FERNET_KEY=
PYTHONPATH=/opt/pipeline/src:/opt/airflow/dags
