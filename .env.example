# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored on purpose.
# ---------------------------------------------------------------------------

# Source API
WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1
WEATHER_API_TIMEOUT_SECONDS=30
WEATHER_API_MAX_RETRIES=5

# Landing zone (local path or s3://... when running in the cloud)
LANDING_ZONE_ROOT=./data/landing

# Snowflake
SNOWFLAKE_ACCOUNT=xy12345.eu-central-1
SNOWFLAKE_USER=etl_loader
SNOWFLAKE_PASSWORD=change-me
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=WH_INGEST_XS
SNOWFLAKE_DATABASE=WEATHER
SNOWFLAKE_RAW_SCHEMA=RAW

# Pipeline behaviour
PIPELINE_ENV=dev
LOG_LEVEL=INFO
